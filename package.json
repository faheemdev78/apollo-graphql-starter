{
  "name": "apollo-graphql-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Schema-first Apollo Server 4 GraphQL API starter with TypeScript, Mongoose, JWT auth, DataLoaders, and graphql-ws subscriptions.",
  "license": "MIT",
  "author": "faheemdev78",
  "keywords": [
    "graphql",
    "apollo-server",
    "typescript",
    "mongoose",
    "mongodb",
    "dataloader",
    "graphql-ws"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-graphql.ts",
    "start": "node dist/index.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "check": "npm run codegen && npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faheemdev78/apollo-graphql-starter.git"
  },
  "bugs": {
    "url": "https://github.com/faheemdev78/apollo-graphql-starter/issues"
  },
  "homepage": "https://github.com/faheemdev78/apollo-graphql-starter#readme",
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@graphql-tools/schema": "^11.0.8",
    "@graphql-tools/utils": "^13.2.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "graphql": "^16.15.0",
    "graphql-scalars": "^2.0.1",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.0",
    "@graphql-codegen/typescript-resolvers": "^7.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
