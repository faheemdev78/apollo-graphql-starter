# Local development defaults. Copy to .env and replace JWT_SECRET before any shared deployment.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/apollo_starter
JWT_SECRET=local-dev-only-not-a-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
GRAPHQL_DEPTH_LIMIT=8
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
